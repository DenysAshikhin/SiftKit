+++ b/tests/test_chunked_prefill.py
@@ -0,0 +1,267 @@
+import torch
+import pytest
+from types import SimpleNamespace
+
+from exllamav3.modules import Module, TransformerBlock
+from exllamav3.model.model import Model
+from exllamav3.modules.attn import prepare_for_attn
+
+
+class AccumulatingAttention(Module):
+    def __init__(self):
+        super().__init__(None, 'test_attention', None)
+        self.total = None
+        self.lengths = []
+        self.positions = []
+        self.markers = []
+
+    def optimizer_targets(self):
+        return []
+
+    def forward(self, x, params, out_dtype=None):
+        self.lengths.append(x.shape[1])
+        self.positions.append(params.get('past_len', 0))
+        self.markers.append(params.get('prepared_marker'))
+        result = x.cumsum(dim=1)
+        if self.total is not None:
+            result += self.total
+        self.total = result[:, -1:].clone()
+        return result
+
+
+class QuadraticMLP(Module):
+    def __init__(self):
+        super().__init__(None, 'test_mlp', None)
+        self.num_slices = 1
+        self.lengths = []
+
+    def optimizer_targets(self):
+        return []
+
+    def forward(self, x, params, out_dtype=None):
+        self.lengths.append(x.shape[1])
+        return x.square() / 100
+
+
+def blocks():
+    return [TransformerBlock(None, f'block{i}', i, attn=AccumulatingAttention(), mlp=QuadraticMLP())
+            for i in range(2)]
+
+
+def test_layer_major_preserves_causality_and_reuses_mlp_across_uneven_chunks():
+    original = torch.arange(20, dtype=torch.float32).view(1, 5, 4) / 32
+    baseline, grouped = blocks(), blocks()
+    expected = []
+    for chunk in original.split(3, dim=1):
+        x = chunk.clone()
+        for block in baseline:
+            x = block.forward(x, {})
+        expected.append(x)
+    actual = [chunk.clone() for chunk in original.split(3, dim=1)]
+    for block in grouped:
+        actual = block.forward_chunked(actual, [{}, {}])
+    assert torch.equal(torch.cat(actual, dim=1), torch.cat(expected, dim=1))
+    for ref, candidate in zip(baseline, grouped):
+        assert torch.equal(ref.attn.total, candidate.attn.total)
+        assert candidate.attn.lengths == [3, 2]
+        assert candidate.mlp.lengths == [5]
+
+
+def test_chunked_terminal_prefill_updates_attention_without_mlp():
+    block = blocks()[0]
+    chunks = [torch.ones(1, 3, 4), torch.ones(1, 2, 4)]
+    result = block.forward_chunked(chunks, [{'prefill': True}, {'prefill': True}])
+    assert block.attn.lengths == [3, 2]
+    assert block.mlp.lengths == []
+    assert len(result) == 2
+
+
+class TinyModel(Model):
+    def __init__(self):
+        super().__init__(SimpleNamespace(moe_cpu_hosts={}))
+        self.modules = blocks()
+        for block in self.modules:
+            block.device = torch.device('cpu')
+        self.fwd_modules = [(block, 0, i) for i, block in enumerate(self.modules)]
+        self.last_kv_module_idx_instance = (1, 0)
+        self.loaded_tp = False
+
+    def prepare_inputs(self, input_ids, params):
+        prepare_for_attn(input_ids, params)
+        return input_ids.float().unsqueeze(-1) / 32
+
+
+def test_grouped_api_keeps_chunk_positions_and_terminal_state():
+    baseline, grouped = TinyModel(), TinyModel()
+    ids = torch.arange(5).view(1, 5)
+    params = dict(attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256),
+                  batch_shape=(1, 256), past_len=0)
+    for offset in (0, 3):
+        baseline.prefill(ids[:, offset:offset + 3], dict(params, past_len=offset))
+    grouped.prefill_chunked(ids, dict(params), chunk_size=3)
+    for ref, candidate in zip(baseline.modules, grouped.modules):
+        assert torch.equal(ref.attn.total, candidate.attn.total)
+        assert candidate.attn.positions == [0, 3]
+        assert candidate.attn.lengths == [3, 2]
+    assert grouped.modules[0].mlp.lengths == [5]
+    assert grouped.modules[1].mlp.lengths == []
+
+
+def test_grouped_api_rejects_invalid_chunk_size_before_mutating_state():
+    model = TinyModel()
+    with pytest.raises(ValueError):
+        model.prefill_chunked(torch.ones(1, 3, dtype=torch.long), {}, chunk_size=0)
+    assert model.modules[0].attn.lengths == []
+
+
+def test_grouped_api_rejects_state_with_global_position_dependencies():
+    model = TinyModel()
+    params = dict(attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256),
+                  batch_shape=(1, 256), past_len=0,
+                  recurrent_states=[SimpleNamespace(position=0)])
+    with pytest.raises(ValueError, match='recurrent'):
+        model.prefill_chunked(torch.ones(1, 3, dtype=torch.long), params, chunk_size=2)
+    assert model.modules[0].attn.lengths == []
+
+
+def test_adjacent_chunk_views_rejoin_without_duplicate_activation_storage():
+    from exllamav3.modules.transformer import join_chunk_views
+    whole = torch.arange(20).view(1, 5, 4)
+    joined = join_chunk_views(list(whole.split(3, dim=1)))
+    assert torch.equal(joined, whole)
+    assert joined.data_ptr() == whole.data_ptr()
+    reordered = join_chunk_views([whole[:, 3:], whole[:, :3]])
+    assert reordered.flatten().tolist() == list(range(12, 20)) + list(range(12))
+
+
+class PreparingModel(TinyModel):
+    def prepare_inputs(self, ids, params):
+        params['prepared_marker'] = 'kept'
+        return super().prepare_inputs(ids, params)
+
+
+class NonCausalModel(TinyModel):
+    def prepare_inputs(self, ids, params):
+        params['causal'] = False
+        return super().prepare_inputs(ids, params)
+
+
+def test_grouped_api_preserves_architecture_preparation():
+    model = PreparingModel()
+    model.prefill_chunked(torch.ones(1, 5, dtype=torch.long), dict(
+        attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256), batch_shape=(1, 256)), 3)
+    assert model.modules[0].attn.markers == ['kept', 'kept']
+
+
+def test_grouped_api_rejects_noncausal_preparation():
+    model = NonCausalModel()
+    with pytest.raises(ValueError, match='causal'):
+        model.prefill_chunked(torch.ones(1, 5, dtype=torch.long), dict(
+            attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256), batch_shape=(1, 256)), 3)
+    assert model.modules[0].attn.lengths == []
+
+
+def test_grouped_api_rejects_cache_overrun_before_attention():
+    model = TinyModel()
+    with pytest.raises(ValueError, match='cache'):
+        model.prefill_chunked(torch.ones(1, 5, dtype=torch.long), dict(
+            attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256),
+            batch_shape=(1, 256), past_len=254), 3)
+    assert model.modules[0].attn.lengths == []
+
+
+class LifetimeMLP(QuadraticMLP):
+    def __init__(self, refs):
+        super().__init__()
+        self.refs = refs
+
+    def forward(self, x, params, out_dtype=None):
+        assert all(ref() is None for ref in self.refs), 'obsolete chunk allocations survive into grouped MLP'
+        return super().forward(x, params, out_dtype)
+
+
+def test_grouped_block_releases_obsolete_chunk_allocations_before_mlp():
+    import weakref
+    chunks = [torch.ones(1, 3, 4), torch.ones(1, 2, 4)]
+    refs = [weakref.ref(chunk) for chunk in chunks]
+    block = TransformerBlock(None, 'lifetime', 0, attn=AccumulatingAttention(), mlp=LifetimeMLP(refs))
+    result = block.forward_chunked(chunks, [{}, {}])
+    assert [x.shape[1] for x in result] == [3, 2]
+
+
+class ChunkNorm(Module):
+    def __init__(self):
+        super().__init__(None, 'norm', None)
+        self.lengths = []
+
+    def optimizer_targets(self):
+        return []
+
+    def can_fuse_residual(self, x, y):
+        return False
+
+    def forward(self, x, params, out_dtype=None):
+        self.lengths.append(x.shape[1])
+        return (x / 2).to(out_dtype or x.dtype)
+
+
+def test_only_mlp_rows_are_grouped_while_normalization_stays_chunked():
+    block = blocks()[0]
+    block.mlp_norm = ChunkNorm()
+    block.forward_chunked([torch.ones(1, 3, 4), torch.ones(1, 2, 4)], [{}, {}])
+    assert block.mlp_norm.lengths == [3, 2]
+    assert block.mlp.lengths == [5]
+
+
+def test_rectangular_cache_lengths_cannot_silently_override_missing_position():
+    model = TinyModel()
+    with pytest.raises(ValueError, match='past_len'):
+        model.prefill_chunked(torch.ones(1, 5, dtype=torch.long), dict(
+            attn_mode='flash_attn', cache=SimpleNamespace(max_num_tokens=256),
+            batch_shape=(1, 256), cache_seqlens=torch.tensor([32])), 3)
+    assert model.modules[0].attn.lengths == []
+
+
+def test_admission_discovers_cuda_modules_when_loader_active_devices_is_empty():
+    model = TinyModel()
+    model.modules[0].device = torch.device('cuda:0')
+    assert model.active_devices == []
+    assert model._prefill_devices() == [0]
+
+
+def test_single_batch_hyperconnection_chunk_views_remain_contiguous():
+    from exllamav3.modules.transformer import join_chunk_views
+    chunks = list(torch.ones(1, 5, 4, 8).split(3, dim=1))
+    whole = join_chunk_views(chunks)
+    for chunk in whole.split(3, dim=1):
+        assert chunk.is_contiguous()
+        assert chunk.view(-1, 4, 8).shape[0] == chunk.shape[1]
+
+
+def test_admission_resolves_implicit_cuda_device_index(monkeypatch):
+    model = TinyModel()
+    model.modules[0].device = torch.device('cuda')
+    monkeypatch.setattr(torch.cuda, 'current_device', lambda: 2)
+    assert model._prefill_devices() == [2]
+
+
+@pytest.mark.parametrize('chunk_size', [True, 1.5])
+def test_grouped_api_rejects_noninteger_chunk_sizes_before_preparation(chunk_size):
+    model = TinyModel()
+    with pytest.raises(ValueError, match='chunk size'):
+        model.prefill_chunked(torch.ones(1, 3, dtype=torch.long), {}, chunk_size)
+    assert model.modules[0].attn.lengths == []
+
+
+@pytest.mark.parametrize('device', ['cuda:0', 0])
+def test_admission_accepts_loader_device_representations(device):
+    model = TinyModel()
+    model.modules[0].device = device
+    assert model._prefill_devices() == [0]
+
+
+def test_admission_excludes_devices_after_terminal_cache_layer():
+    model = TinyModel()
+    model.modules[0].device = torch.device('cuda:0')
+    model.fwd_modules.append((SimpleNamespace(device=torch.device('cuda:1')), 0, 2))
+    assert model._prefill_devices() == [0]
