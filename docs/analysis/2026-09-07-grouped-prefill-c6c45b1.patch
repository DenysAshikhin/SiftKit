@@ -0,0 +1,39 @@
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import torch
+
+
+class RecordingModel:
+    caps = {}
+
+    def __init__(self):
+        self.calls = []
+
+    def prefill(self, ids, params):
+        self.calls.append((params['batch_shape'][1], params['past_len'], ids.clone(), None))
+
+    def prefill_chunked(self, ids, params, chunk_size):
+        self.calls.append((params['batch_shape'][1], params['past_len'], ids.clone(), chunk_size))
+
+
+def test_cli_grouping_preserves_exact_segmented_workload_and_attention_limit(monkeypatch):
+    spec = importlib.util.spec_from_file_location('test_perf_module', Path(__file__).parents[1] / 'eval/perf.py')
+    perf = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(perf)
+    monkeypatch.setattr(perf, 'cuda_sync_active', lambda: None)
+    # Deliberately wrap: one larger workload_ids request would change the tokens.
+    perf._workload_ids = torch.arange(1500).view(1, -1)
+    models = []
+    for grouped in (False, True):
+        model = RecordingModel()
+        perf.measure_prefill(SimpleNamespace(chunk_size=256, max_length=1024,
+            short_prefill=False, grouped_prefill=grouped), model, None)
+        models.append(model)
+    for length in (256, 512, 1024):
+        ref = [call for call in models[0].calls if call[0] == length]
+        actual = [call for call in models[1].calls if call[0] == length]
+        assert len(actual) == 1
+        assert actual[0][1] == ref[0][1]
+        assert actual[0][3] == 256
+        assert torch.equal(actual[0][2], torch.cat([call[2] for call in ref], dim=1))
