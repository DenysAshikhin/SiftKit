+++ b/exllamav3/model/prefill_budget.py
@@ -0,0 +1,43 @@
+def group_capacity(requested, total, free, reserved, idle, peak, activation, *, growth=None):
+    """Bound grouping by live VRAM and an observed single-chunk workspace.
+
+    All sizes are bytes. Cached allocator blocks are reusable, but WDDM may reserve
+    beyond physical capacity. Each additional chunk pays a full observed workspace
+    plus its retained activation; no device or model-specific constants are used.
+    """
+    if requested < 1 or min(total, free, reserved, idle, peak, activation) < 0:
+        raise ValueError("invalid prefill memory observation")
+    workspace = peak - idle
+    if workspace <= 0 or activation == 0:
+        return 1
+    available = min(total, free + reserved)
+    extra = max(0, available - peak)
+    per_chunk = workspace + activation if growth is None else growth
+    if per_chunk <= 0:
+        raise ValueError("invalid grouped workspace growth")
+    return min(requested, 1 + extra // per_chunk)
+
+
+def mlp_row_growth(activation, mlp):
+    """Conservative row-dependent storage for the engine's dense/MoE MLP paths.
+
+    Attention and normalization stay at physical chunk size. Count two residual
+    groups, normalized/gathered half inputs, float output/partial sums, gate/up and
+    converted intermediate arrays, full routing matrices and sorted assignments.
+    Fixed reconstruction and fused-expert buffers are covered by the observed peak.
+    """
+    hidden = getattr(mlp, "hidden_size", None)
+    intermediate = getattr(mlp, "intermediate_size_padded", getattr(mlp, "intermediate_size", None))
+    if hidden is None or intermediate is None:
+        return None
+    dtype = getattr(mlp, "interm_dtype", None)
+    itemsize = max(2, dtype.itemsize if dtype is not None else 2)
+    shared = getattr(mlp, "shared_experts", None)
+    if shared is not None:
+        intermediate += shared.intermediate_size
+        shared_dtype = getattr(shared, "interm_dtype", None)
+        itemsize = max(itemsize, shared_dtype.itemsize if shared_dtype is not None else 2)
+    experts = getattr(mlp, "num_experts", 0)
+    topk = getattr(mlp, "num_experts_per_tok", 0)
+    return (2 * activation + hidden * (6 * 2 + 4 * 4)
+            + 4 * intermediate * itemsize + 8 * experts * 4 + 8 * topk * 8)
diff --git a/tests/test_chunked_prefill.py b/tests/test_chunked_prefill.py
