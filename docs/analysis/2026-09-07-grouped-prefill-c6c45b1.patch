+"""Validated cache topology and bounded staging/probe policies."""
+
+import ctypes
+import os
+from pathlib import Path
+import re
+import struct
+import sys
+
+
+def parse_windows_l3(records):
+    sizes = []
+    offset = 0
+    while offset < len(records):
+        if len(records) - offset < 20:
+            raise ValueError("truncated Windows cache topology")
+        relationship, length, level, _, _, size, cache_type = struct.unpack_from('<IIBBHII', records, offset)
+        if relationship != 2 or length < 20 or offset + length > len(records):
+            raise ValueError("invalid Windows cache relationship")
+        if level == 3 and cache_type in (0, 2):
+            if size == 0:
+                raise ValueError("empty L3 cache")
+            sizes.append(size)
+        offset += length
+    if not sizes:
+        raise ValueError("no L3 cache reported")
+    return min(sizes)
+
+
+def linux_l3(root, cpus):
+    sizes = []
+    for cpu in cpus:
+        found = False
+        for entry in (Path(root) / f'cpu{cpu}' / 'cache').glob('index*'):
+            if (entry / 'level').read_text().strip() != '3':
+                continue
+            if (entry / 'type').read_text().strip() not in ('Unified', 'Data'):
+                continue
+            raw = (entry / 'size').read_text().strip()
+            match = re.fullmatch(r'([1-9][0-9]*)([KMG]?)', raw)
+            if match is None:
+                raise ValueError(f"invalid cache size: {raw!r}")
+            sizes.append(int(match[1]) * 1024 ** ('', 'K', 'M', 'G').index(match[2]))
+            found = True
+        if not found:
+            raise ValueError(f"no L3 cache reported for CPU {cpu}")
+    if not sizes:
+        raise ValueError("no CPUs available for cache detection")
+    return min(sizes)
+
+
+def detect_l3():
+    if sys.platform == 'win32':
+        api = ctypes.WinDLL('kernel32', use_last_error=True).GetLogicalProcessorInformationEx
+        api.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
+        api.restype = ctypes.c_int
+        length = ctypes.c_ulong()
+        api(2, None, ctypes.byref(length))
+        if ctypes.get_last_error() != 122 or length.value == 0:
+            raise ctypes.WinError(ctypes.get_last_error())
+        records = ctypes.create_string_buffer(length.value)
+        if not api(2, records, ctypes.byref(length)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        return parse_windows_l3(records.raw[:length.value])
+    if sys.platform == 'linux':
+        return linux_l3('/sys/devices/system/cpu', os.sched_getaffinity(0))
+    raise RuntimeError(f"L3 detection unsupported on {sys.platform}; set an explicit piece size")
+
+
+def piece_geometry(cache_bytes, expert_bytes, depth, batch_capacity):
+    if min(cache_bytes, expert_bytes, depth, batch_capacity) <= 0:
+        raise ValueError("cache, expert, depth and batch capacity must be positive")
+    # Retain the ring plus one source piece in the shared cache domain.
+    experts = min(batch_capacity, cache_bytes // ((depth + 1) * expert_bytes))
+    if experts == 0:
+        raise ValueError("L3 cannot hold the ring and one source expert; set an explicit piece size")
+    return experts
+
+
+def probe_needs_retry(samples):
+    if not samples or any(not 0 < x < float('inf') for x in samples):
+        raise ValueError("bandwidth samples must be finite and positive")
+    if len(samples) >= 3:
+        return False
+    return len(samples) < 2 or max(samples[-2:]) > 1.1 * min(samples[-2:])
