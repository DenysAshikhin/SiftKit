+
+
+def test_live_pressure_can_reduce_capacity_to_one():
+    assert group_capacity(8, 1000, 0, 710, 500, 700, 50) == 1
+
+
+def test_requested_chunks_bound_capacity_and_exact_fit_is_allowed():
