+import struct
+import pytest
+
+from exllamav3.model import moe_staging
+
+
+def cache_record(level, size):
+    return struct.pack('<IIBBHII', 2, 56, level, 255, 64, size, 0) + bytes(36)
+
+
+def test_windows_l3_uses_smallest_domain_not_sum():
+    records = cache_record(2, 1 << 20) + cache_record(3, 32 << 20) + cache_record(3, 64 << 20)
+    assert moe_staging.parse_windows_l3(records) == 32 << 20
+
+
+@pytest.mark.parametrize('records', [b'', bytes(7), cache_record(3, 0), cache_record(3, 32 << 20)[:-1], bytes(56)])
+def test_windows_cache_rejects_absent_or_malformed_io(records):
+    with pytest.raises(ValueError):
+        moe_staging.parse_windows_l3(records)
+
+
+def test_ring_leaves_room_for_source_piece_and_obeys_batch_capacity():
+    assert moe_staging.piece_geometry(32 << 20, 2457600, 2, 24) == 4
+    assert moe_staging.piece_geometry(8 << 20, 1 << 20, 2, 24) == 2
+    assert moe_staging.piece_geometry(256 << 20, 1 << 20, 3, 12) == 12
+    with pytest.raises(ValueError):
+        moe_staging.piece_geometry(1 << 20, 1 << 20, 2, 24)
+
+
+@pytest.mark.parametrize('samples,expected', [
+    ([6.8], True), ([6.8, 26.7], True), ([6.8, 26.7, 26.6], False),
+    ([6.7, 6.8], False), ([26.7, 26.6], False),
+])
+def test_probe_repeats_changes_without_rejecting_a_stable_slow_link(samples, expected):
+    assert moe_staging.probe_needs_retry(samples) == expected
+
+
+def test_linux_discovers_index_and_parses_units(tmp_path):
+    root = tmp_path / 'cpu'
+    for cpu, size in ((0, '32768K'), (1, '64M')):
+        entry = root / f'cpu{cpu}' / 'cache/index7'
+        entry.mkdir(parents=True)
+        (entry / 'level').write_text('3\n')
+        (entry / 'type').write_text('Unified\n')
+        (entry / 'size').write_text(size + '\n')
+    assert moe_staging.linux_l3(root, [0, 1]) == 32 << 20
+    (root / 'cpu1/cache/index7/size').write_text('garbage')
+    with pytest.raises(ValueError):
+        moe_staging.linux_l3(root, [0, 1])
