+// -------------------------------------------------------------------------------------------
+//   Streamed-prefill un-swizzle
+// -------------------------------------------------------------------------------------------
+
+// The CPU arena keeps trellis tensors band-contiguous (tile (kt, nt) at ((nt / 8) * tiles_k +
+// kt) * 8 + nt % 8, see _HugeArena.rehome); the GPU dequant path reads the native (kt, nt)
+// order. Streamed experts are DMA'd verbatim from the arena and repacked here, VRAM to VRAM,
+// one 16-byte unit per thread. Expert blocks are [gate | up | down] trellis bytes back to
+// back, all experts of a batch consecutive, and K8 tensors are never swizzled (identity).
+
+struct UnswzProj { uint32_t bytes; uint32_t tiles_k; uint32_t tiles_n; uint32_t tile_b; uint32_t swz; };
+
+__global__ void moe_unswizzle_kernel
+(
+    uint4* __restrict__ dst,
+    const uint4* __restrict__ src,
+    UnswzProj p0, UnswzProj p1, UnswzProj p2,
+    uint32_t expert_bytes,
+    uint32_t total_units
+)
+{
+    const uint32_t u = blockIdx.x * blockDim.x + threadIdx.x;
+    if (u >= total_units) return;
+    const uint32_t units_per_expert = expert_bytes / 16;
+    const uint32_t e = u / units_per_expert;
+    uint32_t o = (u - e * units_per_expert) * 16;
+    uint32_t base = e * expert_bytes;
+    UnswzProj p = p0;
+    if (o >= p.bytes) { o -= p.bytes; base += p.bytes; p = p1; }
+    if (o >= p.bytes) { o -= p.bytes; base += p.bytes; p = p2; }
+    uint32_t src_o = o;
+    if (p.swz)
+    {
+        const uint32_t tile = o / p.tile_b;
+        const uint32_t within = o - tile * p.tile_b;
+        const uint32_t kt = tile / p.tiles_n;
+        const uint32_t nt = tile - kt * p.tiles_n;
+        src_o = (((nt >> 3) * p.tiles_k + kt) * 8 + (nt & 7)) * p.tile_b + within;
+    }
+    dst[(base + o) / 16] = src[(base + src_o) / 16];
+}
+
+void exl3_moe_unswizzle
+(
+    const at::Tensor& dst,
+    const at::Tensor& src,
+    int64_t num_experts,
+    const std::vector<int64_t>& proj_dims,   // flat [k, n, K] x 3, gate first; k = 0 when gateless
+    int64_t expert_bytes
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(dst.device());
+    TORCH_CHECK(dst.is_cuda() && src.is_cuda() && dst.dtype() == at::kByte && src.dtype() == at::kByte,
+                "unswizzle: uint8 device tensors expected");
+    TORCH_CHECK(proj_dims.size() == 9, "unswizzle: three [k, n, K] projections expected");
+    TORCH_CHECK(expert_bytes % 16 == 0, "unswizzle: expert block must be 16-byte aligned");
+    UnswzProj p[3];
+    int64_t sum = 0;
+    for (int i = 0; i < 3; ++i)
+    {
+        const int64_t k = proj_dims[i * 3], n = proj_dims[i * 3 + 1], K = proj_dims[i * 3 + 2];
+        p[i].tiles_k = (uint32_t) (k / 16);
+        p[i].tiles_n = (uint32_t) (n / 16);
+        p[i].tile_b = (uint32_t) (K * 32);
+        p[i].bytes = (uint32_t) ((k / 16) * (n / 16) * K * 32);
+        p[i].swz = (k > 0 && K != 8) ? 1u : 0u;
+        sum += p[i].bytes;
+    }
+    TORCH_CHECK(sum == expert_bytes, "unswizzle: projection bytes do not sum to expert_bytes");
+    const int64_t total_bytes = num_experts * expert_bytes;
+    TORCH_CHECK(src.numel() >= total_bytes && dst.numel() >= total_bytes, "unswizzle: slot too small");
+    const uint32_t total_units = (uint32_t) (total_bytes / 16);
+    const int threads = 256;
+    const int blocks = (int) ((total_units + threads - 1) / threads);
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    moe_unswizzle_kernel<<<blocks, threads, 0, stream>>>(
+        reinterpret_cast<uint4*>(dst.data_ptr()),
+        reinterpret_cast<const uint4*>(src.data_ptr()),
+        p[0], p[1], p[2], (uint32_t) expert_bytes, total_units);
+    cuda_check(cudaPeekAtLastError());
 }
