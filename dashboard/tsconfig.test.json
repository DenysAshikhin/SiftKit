{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Mandatory override: this config extends dashboard/tsconfig.json and would otherwise
    // share — and corrupt — that project's buildinfo file.
    "incremental": true,
    "tsBuildInfoFile": "./.tscache/dashboard-test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/server": ["./node_modules/@types/react-dom/server"],
      "@siftkit/contracts": ["../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../src/config/types.ts",
    "../src/types/better-sqlite3.d.ts",
    "../src/web-search/types.ts",
    "../src/presets.ts",
    "../tests/dashboard-app-refresh.test.ts",
    "../tests/dashboard-api.test.ts",
    "../tests/dashboard-toasts.test.ts",
    "../tests/dashboard-benchmark-controller.test.ts",
    "../tests/dashboard-settings-controller.test.ts",
    "../tests/dashboard-model-presets-section.test.ts",
    "../tests/dashboard-presets-section.test.ts",
    "../tests/dashboard-runs-controller-e2e.test.ts"
  ]
}
