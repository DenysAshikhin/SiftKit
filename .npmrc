# Disable the post-install registry audit for every npm invocation in this repo.
#
# Two reasons, both load-bearing:
#
# 1. Hang: the bulk advisory POST has no client-side timeout. It runs after reify has already
#    finished writing node_modules, so a stalled request hangs the command indefinitely with
#    the install work fully complete. This is what wedged `npm run refresh-global` after
#    `reify:save`.
# 2. Disclosure: arborist's shouldAudit() excludes only root/versionless nodes, so it has no
#    workspace or link exemption and ignores `private: true`. The names and versions of the
#    unpublished workspace packages (@siftkit/contracts, siftkit-dashboard) were being sent to
#    registry.npmjs.org on every install.
#
# Audit findings are informational here anyway: the request runs after install, cannot change
# what is written to disk, and does not affect `npm install`'s exit code. Run `npm audit`
# explicitly when you actually want advisory data.
audit=false
