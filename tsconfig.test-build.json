{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "bench/**/*.ts",
    "tests/**/*.ts"
  ]
}
